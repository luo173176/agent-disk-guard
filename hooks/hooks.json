{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|bash|PowerShell|powershell|pwsh|Shell|shell|cmd|Write|write|Edit|edit|MultiEdit|multiedit|multi_edit|NotebookEdit|notebookedit|notebook_edit|NotebookEditCell|notebookeditcell|ApplyPatch|apply_patch|str_replace_editor)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/session-check.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
