{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/session-check.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
