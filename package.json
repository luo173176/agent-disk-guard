{
  "name": "agent-disk-guard",
  "version": "0.3.5",
  "description": "AgentDiskGuard — prevent AI coding agents (Claude Code, ZCode, DeepSeek Harness, ...) from filling up drive C: (hook interception, cache redirection, env injection, robocopy+junction migration, disk monitoring).",
  "author": "luo173176",
  "license": "MIT",
  "homepage": "https://github.com/luo173176/agent-disk-guard",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@ssh.github.com:443/luo173176/agent-disk-guard.git"
  },
  "bugs": {
    "url": "https://github.com/luo173176/agent-disk-guard/issues"
  },
  "bin": {
    "agent-disk-guard": "./bin/agent-disk-guard.cjs"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dsh": "./dsh/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dsh",
    "hooks",
    "config",
    "bin",
    "skills",
    "commands",
    "docs",
    "cordis.patch.yml",
    ".claude-plugin",
    ".zcode-plugin",
    "install.ps1",
    "uninstall.ps1",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "postbuild": "node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "disk-guard",
    "npm-cache",
    "pip-cache",
    "junction",
    "windows",
    "claude-code",
    "deepseek-harness",
    "dsh-bundle",
    "hooks"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/dsh-hooks-claude-code": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
